{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minitrace.spec/envelope/v0.1.0/manifest.schema.json",
  "title": "minitrace-envelope v0.1.0 manifest schema",
  "description": "Normative JSON Schema for the minitrace-envelope manifest (minitrace-envelope-spec v0.1.0 §4). The root validates a manifest.json document. Per spec §13, v0.1.0 ships one schema file. The signature.json document (§9) validates against #/$defs/SignatureFile (it is a separate file at envelope root, not part of the manifest root). Per-event x-* witness payloads (§7.6) are NDJSON sidecar files, not part of the manifest; this schema validates the witness *record* (kind, scope, paths, metadata declarations), including the §7.6.1 metadata.tool_call_id_attribution declaration the eight kernel-side x-* kinds MUST carry.",
  "type": "object",
  "required": ["envelope_version", "envelope_id", "created_at", "producer", "traces"],
  "properties": {
    "envelope_version": {"const": "0.1.0"},
    "envelope_id": {"type": "string", "minLength": 1},
    "created_at": {"$ref": "#/$defs/Iso8601Micros"},
    "producer": {"$ref": "#/$defs/Producer"},
    "clocks": {"type": "array", "items": {"$ref": "#/$defs/Clock"}},
    "traces": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/TraceListing"},
      "contains": {"properties": {"primary": {"const": true}}, "required": ["primary"]},
      "minContains": 0,
      "maxContains": 1
    },
    "raw_artefacts": {"type": "array", "items": {"$ref": "#/$defs/RawArtefact"}},
    "witnesses": {"type": "array", "items": {"$ref": "#/$defs/Witness"}},
    "annotations": {"type": "array", "items": {"$ref": "#/$defs/Annotation"}},
    "bindings": {"type": "array", "items": {"$ref": "#/$defs/Binding"}},
    "extensions": {"$ref": "#/$defs/Extensions"}
  },
  "additionalProperties": true,

  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Sha256OrNull": {
      "oneOf": [{"$ref": "#/$defs/Sha256"}, {"type": "null"}]
    },
    "Iso8601Micros": {
      "description": "ISO 8601 UTC at microsecond precision per §4.4 / minitrace-spec §3.5.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "Iso8601": {
      "description": "ISO 8601 date-time (Z or numeric offset; fractional seconds optional). Used for the §7.1/§4.9/§9 timestamps the spec labels only 'ISO 8601'.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "RelPath": {
      "description": "A path relative to the envelope root (§3.2): forward slashes, no leading slash, and no '.' or '..' path segment (a literal dot inside a filename, e.g. 'a.log' or 'archive..2026/x', is fine; only whole '.'/'..' segments are forbidden). Symbolic-link traversal (§3.2) cannot be checked from the string alone and is left to the loader.",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!(.*/)?\\.\\.?(/|$)).+$"
    },
    "Extensions": {
      "description": "Vendor-scoped (ext:<vendor>:<name>) or experimental (x-<name>) keys, arbitrary JSON values (§4.10).",
      "type": "object",
      "propertyNames": {"pattern": "^(x-.+|ext:[^:]+:.+)$"}
    },

    "Producer": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["automated_pipeline", "human_assembled", "hybrid"]},
        "tool": {"type": "string"},
        "host_clock_id": {"type": "string"},
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    },

    "Clock": {
      "type": "object",
      "required": ["id", "kind", "manipulated"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {
          "type": "string",
          "pattern": "^(host_system|external_authority|simulated|frozen|manipulated|x-.+)$"
        },
        "description": {"type": "string"},
        "authority": {"type": ["string", "null"]},
        "drift_attestation": {
          "type": ["object", "null"],
          "properties": {
            "reference_authority": {"type": "string"},
            "offset_at_start_ms": {"type": "integer"},
            "offset_at_end_ms": {"type": "integer"},
            "measurement_method": {
              "type": "string",
              "pattern": "^(ntp_offset|rfc3161_roundtrip|x-.+)$"
            }
          },
          "additionalProperties": true
        },
        "manipulated": {"type": "boolean"},
        "manipulation_notes": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"manipulated": {"const": true}}, "required": ["manipulated"]},
          "then": {"required": ["manipulation_notes"], "properties": {"manipulation_notes": {"minLength": 1}}}
        }
      ],
      "additionalProperties": true
    },

    "TraceListing": {
      "type": "object",
      "required": ["trace_id", "path", "trace_content_hash", "file_content_hash", "schema_version"],
      "properties": {
        "trace_id": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/RelPath"},
        "trace_content_hash": {"$ref": "#/$defs/Sha256"},
        "file_content_hash": {"$ref": "#/$defs/Sha256"},
        "trace_type": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "primary": {"type": "boolean"},
        "clock_id": {"type": "string"}
      },
      "additionalProperties": true
    },

    "RawArtefact": {
      "type": "object",
      "required": ["id", "path", "kind", "content_hash"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/RelPath"},
        "kind": {"type": "string", "pattern": "^(harness_log|source_file|config|x-.+)$"},
        "harness": {"type": "string"},
        "content_hash": {"$ref": "#/$defs/Sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "produces_trace_id": {"type": "string"},
        "redaction": {"$ref": "#/$defs/Redaction"}
      },
      "additionalProperties": true
    },

    "Witness": {
      "type": "object",
      "required": ["id", "kind", "captured_at", "content_hash", "primary_path"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {
          "type": "string",
          "pattern": "^(network_capture|screenshot|screen_recording|environment_snapshot|process_tree|filesystem_snapshot|harness_artefact|inference_capture|external_log|binary_capture|x-.+|ext:[^:]+:.+)$"
        },
        "scope": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {"type": "string", "enum": ["envelope", "trace", "turn", "tool_call", "policy_trigger", "segment"]},
            "target_id": {"type": "string"},
            "target_trace_id": {"type": "string"}
          },
          "allOf": [
            {
              "if": {"properties": {"type": {"const": "trace"}}, "required": ["type"]},
              "then": {"required": ["target_trace_id"]}
            },
            {
              "if": {"properties": {"type": {"enum": ["turn", "tool_call", "policy_trigger", "segment"]}}, "required": ["type"]},
              "then": {"required": ["target_id", "target_trace_id"]}
            }
          ],
          "additionalProperties": true
        },
        "captured_at": {"$ref": "#/$defs/Iso8601"},
        "captured_by": {"type": "string"},
        "content_hash": {"$ref": "#/$defs/Sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "primary_path": {"$ref": "#/$defs/RelPath"},
        "auxiliary_paths": {"type": "array", "items": {"$ref": "#/$defs/RelPath"}},
        "metadata": {"type": "object"},
        "redaction": {"$ref": "#/$defs/Redaction"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "x-process-exec-trace", "x-file-access-trace", "x-network-flow-trace",
                  "x-syscall-trace", "x-process-hook-trace", "x-tls-keylog-trace",
                  "x-lsm-event-trace", "x-resource-event-trace"
                ]
              }
            },
            "required": ["kind"]
          },
          "then": {
            "description": "§7.6.1: every kernel-side x-* witness record MUST declare its correlation discipline in metadata.tool_call_id_attribution.",
            "required": ["metadata"],
            "properties": {
              "metadata": {
                "type": "object",
                "required": ["tool_call_id_attribution"],
                "properties": {
                  "tool_call_id_attribution": {"type": "string", "enum": ["always", "when_known", "never"]}
                }
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },

    "Redaction": {
      "description": "Witness / raw-artefact redaction record (§7.4, §10.4).",
      "type": ["object", "null"],
      "required": ["operation", "reason_code", "authorised_by", "authorised_at"],
      "properties": {
        "operation": {"type": "string", "enum": ["remove", "pseudonymise", "truncate", "mask", "generalise"]},
        "reason_code": {
          "type": "string",
          "pattern": "^(operator_privacy|pii_detected|confidentiality|legal_hold|submitter_anonymity|gdpr_erasure|x-.+)$"
        },
        "authorised_by": {"type": "string"},
        "authorised_at": {"$ref": "#/$defs/Iso8601"},
        "original_content_hash": {"$ref": "#/$defs/Sha256OrNull"}
      },
      "additionalProperties": true
    },

    "Annotation": {
      "description": "Envelope-level annotation (§4.9).",
      "type": "object",
      "required": ["id", "scope", "annotator", "content"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "scope": {
          "type": "object",
          "required": ["type", "target_id"],
          "properties": {
            "type": {"type": "string", "enum": ["envelope", "trace", "raw_artefact", "witness"]},
            "target_id": {"type": "string"}
          },
          "additionalProperties": true
        },
        "annotator": {"type": "string"},
        "authored_at": {"$ref": "#/$defs/Iso8601"},
        "content": {"type": "object"}
      },
      "additionalProperties": true
    },

    "Binding": {
      "description": "Binding-sidecar listing (§4.11). The manifest lists and checksums the sidecar; the record format is owned by the spec named for each kind.",
      "type": "object",
      "required": ["kind", "path", "content_hash"],
      "properties": {
        "kind": {"type": "string", "pattern": "^(scenario-binding|adapter-identity|x-.+)$"},
        "path": {"$ref": "#/$defs/RelPath"},
        "content_hash": {"$ref": "#/$defs/Sha256"},
        "produces_trace_id": {"type": "string"}
      },
      "additionalProperties": true
    },

    "SignatureFile": {
      "description": "Shape of signature.json (§9.1). A separate file at envelope root; validate it against this $def. The cryptographic profile is deferred (§9.2): 'algorithm' is opaque in v0.1.0.",
      "type": "object",
      "required": ["signatures"],
      "properties": {
        "signatures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "signer", "algorithm", "key_id", "manifest_hash", "signed_at", "signature", "covers"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "signer": {"type": "string"},
              "algorithm": {"type": "string"},
              "key_id": {"type": "string"},
              "manifest_hash": {"$ref": "#/$defs/Sha256"},
              "signed_at": {"$ref": "#/$defs/Iso8601"},
              "signature": {"type": "string"},
              "covers": {
                "type": "array",
                "items": {"type": "string", "enum": ["manifest"]}
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  }
}
